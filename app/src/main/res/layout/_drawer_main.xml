<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:orientation="vertical">
	<LinearLayout
		android:id="@+id/linear1"
		android:layout_width="300dp"
		android:layout_height="match_parent"
		android:background="#FFFFFF"
		android:orientation="vertical">
		<LinearLayout
			android:id="@+id/linear2"
			android:layout_width="match_parent"
			android:layout_height="200dp"
			android:padding="8dp"
			android:background="#00B276"
			android:orientation="horizontal">
			<LinearLayout
				android:id="@+id/linear6"
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:padding="8dp"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="vertical"
				android:layout_gravity="center_horizontal|center_vertical">
				<de.hdodenhof.circleimageview.CircleImageView
					android:id="@+id/circleimageview1"
					android:layout_width="match_parent"
					android:layout_height="wrap_content"
					android:src="@drawable/default_profile_pic"
					app:civ_border_width="3dp"
					app:civ_border_color="#008DCD"
					app:civ_circle_background_color="#FFFFFF"
					app:civ_border_overlay="true" />
				<TextView
					android:id="@+id/textview1"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:padding="8dp"
					android:text="حسابي"
					android:textSize="18sp"
					android:textStyle="bold"
					android:textColor="#FFFFFF" />
			</LinearLayout>
		</LinearLayout>
		<LinearLayout
			android:id="@+id/settings"
			android:layout_width="match_parent"
			android:layout_height="50dp"
			android:layout_margin="5dp"
			android:gravity="right|center_vertical"
			android:orientation="horizontal">
			<LinearLayout
				android:id="@+id/linear11"
				android:layout_width="60dp"
				android:layout_height="match_parent"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="vertical">
				<ImageView
					android:id="@+id/imageview3"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:src="@drawable/ic_settings"
					android:scaleType="fitCenter" />
			</LinearLayout>
			<TextView
				android:id="@+id/textview4"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:text="الإعدادات"
				android:textSize="16sp"
				android:textStyle="bold"
				android:textColor="#00B276"
				android:layout_weight="1" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/about"
			android:layout_width="match_parent"
			android:layout_height="50dp"
			android:layout_margin="5dp"
			android:gravity="right|center_vertical"
			android:orientation="horizontal">
			<LinearLayout
				android:id="@+id/linear12"
				android:layout_width="60dp"
				android:layout_height="match_parent"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="vertical">
				<ImageView
					android:id="@+id/imageview4"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:src="@drawable/about"
					android:scaleType="fitStart" />
			</LinearLayout>
			<TextView
				android:id="@+id/textview5"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:text="حول التطبيق"
				android:textSize="16sp"
				android:textStyle="bold"
				android:textColor="#00B276"
				android:layout_weight="1" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/language"
			android:layout_width="match_parent"
			android:layout_height="50dp"
			android:layout_margin="5dp"
			android:orientation="horizontal">
			<LinearLayout
				android:id="@+id/linear15"
				android:layout_width="50dp"
				android:layout_height="match_parent"
				android:orientation="vertical">
				<ImageView
					android:id="@+id/imageview6"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:src="@drawable/icon_language_round"
					android:scaleType="fitXY" />
			</LinearLayout>
			<TextView
				android:id="@+id/textview7"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:gravity="right"
				android:text="لغة التطبيق"
				android:textSize="16sp"
				android:textStyle="bold"
				android:textColor="#01B276"
				android:layout_gravity="right|center_vertical"
				android:layout_weight="1" />
		</LinearLayout>
		<LinearLayout
			android:id="@+id/exit"
			android:layout_width="match_parent"
			android:layout_height="50dp"
			android:layout_margin="5dp"
			android:gravity="right|center_vertical"
			android:orientation="horizontal">
			<LinearLayout
				android:id="@+id/linear13"
				android:layout_width="60dp"
				android:layout_height="match_parent"
				android:gravity="center_horizontal|center_vertical"
				android:orientation="vertical">
				<ImageView
					android:id="@+id/imageview5"
					android:layout_width="match_parent"
					android:layout_height="match_parent"
					android:src="@drawable/exit"
					android:scaleType="fitCenter" />
			</LinearLayout>
			<TextView
				android:id="@+id/textview6"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:padding="8dp"
				android:text="خروج"
				android:textSize="16sp"
				android:textStyle="bold"
				android:textColor="#00B276"
				android:layout_weight="1" />
		</LinearLayout>
	</LinearLayout>
</LinearLayout>
